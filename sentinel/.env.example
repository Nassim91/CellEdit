# ── Sentinel Yield Agent Configuration ──

# ── DeFiLlama ──
# Pro API key for yields endpoints (optional — falls back to free API)
# Get a key at: https://defillama.com/pro-api
DEFILLAMA_API_KEY=

# ── Twitter / X API (for social sentiment scraping) ──
# Get API keys at: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ENABLED=false

# ── Blockchain RPC endpoints (optional — public RPCs used as fallback) ──
RPC_ETHEREUM=https://eth.llamarpc.com
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_OPTIMISM=https://mainnet.optimism.io
RPC_BASE=https://mainnet.base.org
RPC_POLYGON=https://polygon-rpc.com
RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
RPC_BSC=https://bsc-dataseed.binance.org
RPC_SOLANA=https://api.mainnet-beta.solana.com

# ── Funding Rates ──
FUNDING_BINANCE_ENABLED=true
FUNDING_BYBIT_ENABLED=true
FUNDING_DYDX_ENABLED=true
FUNDING_HYPERLIQUID_ENABLED=true
FUNDING_MIN_FUNDING_RATE_ANNUALIZED=2.0

# ── Filters ──
FILTER_MIN_TVL_USD=100000
FILTER_MIN_APY=0.5
FILTER_MAX_RISK_SCORE=0.8
FILTER_ONLY_AUDITED=false

# ── Output ──
REPORT_OUTPUT_DIR=./reports

# ── Performance ──
MAX_CONCURRENT_REQUESTS=10
CACHE_TTL_SECONDS=300

# ── Logging ──
LOG_LEVEL=INFO
